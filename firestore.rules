rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSeahUser() {
      return request.auth != null
        && request.auth.token.email.matches('.*@seah[.]co[.]kr$');
    }

    match /{document=**} {
      allow read, write: if isSeahUser();
    }
  }
}
